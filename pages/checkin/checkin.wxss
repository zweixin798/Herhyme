.record-page { padding-top: 38rpx; }
.page-head { padding-bottom: 36rpx; }
.page-head .title { margin-top: 10rpx; }
.record-intro { margin-top: 16rpx; max-width: 620rpx; }

.record-editor { padding: 20rpx 0 40rpx; }
.editor-label { align-items: flex-end; margin-bottom: 22rpx; }
.editor-label .section-title { margin-top: 8rpx; }
.parsing-state { align-items: center; color: #2f7d57; display: flex; font-size: 20rpx; }
.parsing-state::before { animation: quiet-pulse 1.4s ease-in-out infinite; background: #2f7d57; border-radius: 50%; content: ""; height: 10rpx; margin-right: 10rpx; width: 10rpx; }
.record-editor .textarea { min-height: 226rpx; }
.suggestion { color: #7b827d; font-size: 20rpx; line-height: 1.55; margin: 16rpx 0 24rpx; }
.save-record { justify-content: space-between; width: 100%; }

.parse-error { background: #f2e7e4; border-left: 4rpx solid #b65f52; color: #854d45; margin: 0 -36rpx; padding: 24rpx 36rpx; }
.parse-error-text { font-size: 23rpx; line-height: 1.55; }
.parse-error-actions { justify-content: flex-start; margin-top: 16rpx; }
.parse-error-actions .button-secondary { line-height: 62rpx; min-height: 62rpx; }
.text-button { background: transparent; color: #9c594f; font-size: 22rpx; margin: 0; padding: 0; }
.inline-button { line-height: 62rpx; margin-left: 24rpx; }

.parse-card { background: #e7f3eb; border-radius: 8rpx; margin-top: 24rpx; padding: 32rpx 30rpx 36rpx; }
.parse-heading { align-items: flex-start; }
.parse-heading .section-title { margin-top: 8rpx; }
.parsed-type { border-bottom: 1rpx solid #3f9366; color: #245e43; font-size: 20rpx; padding: 5rpx 0; }
.confirm-question { color: #183c2a; font-size: 30rpx; font-weight: 560; line-height: 1.6; margin-top: 32rpx; }
.parse-notice { border-left: 3rpx solid #b17852; color: #665a50; font-size: 22rpx; line-height: 1.6; margin-top: 22rpx; padding: 6rpx 0 6rpx 18rpx; }
.parsed-fields { border-top: 1rpx solid #bdc9c0; margin-top: 30rpx; padding-top: 24rpx; }
.field-caption { color: #6f7872; font-size: 20rpx; margin-bottom: 8rpx; }
.diet-item { border-bottom: 1rpx solid #c7d1ca; padding: 20rpx 0 26rpx; }
.diet-item:first-child { padding-top: 0; }
.diet-item-head { margin-bottom: 10rpx; }
.remove-item { background: transparent; color: #a55d51; font-size: 20rpx; line-height: 48rpx; margin: 0; padding: 0; }
.compact-input { background: transparent; border: 0; border-bottom: 1rpx solid #9facA3; border-radius: 0; color: #171a18; font-size: 25rpx; height: 72rpx; margin-bottom: 12rpx; padding: 0 2rpx; width: 100%; }
.diet-number-grid { display: grid; gap: 22rpx; grid-template-columns: 1fr 1fr; }
.diet-number-grid .compact-input { margin-bottom: 0; }
.add-item { font-size: 23rpx; line-height: 66rpx; margin-top: 20rpx; width: 100%; }
.picker-value { border-bottom: 1rpx solid #9faca3; color: #171a18; font-size: 25rpx; height: 72rpx; padding: 0 2rpx; }
.compact-picker { line-height: 72rpx; }
.period-switch { border-bottom: 1rpx solid #bdc9c0; color: #414a44; font-size: 24rpx; margin: 10rpx 0 6rpx; padding: 16rpx 0; }
.spaced-caption { margin-top: 14rpx; }
.parse-actions { border-top: 1rpx solid #bdc9c0; margin-top: 30rpx; padding-top: 26rpx; }
.parse-actions .button-primary, .parse-actions .button-secondary { width: 100%; }
.parse-actions .button-secondary { margin-top: 12rpx; }
.saved-note { border-bottom: 1rpx solid #a7c8b2; color: #2f7d57; font-size: 22rpx; padding: 22rpx 0; }
