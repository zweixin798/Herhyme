<view class="page stack">
  <view class="row">
    <view>
      <view class="eyebrow">HER RHYME</view>
      <view class="title">今天怎么动？</view>
    </view>
    <view class="date-label">{{todayLabel}}</view>
  </view>

  <view class="card status-card">
    <view class="status-head row"><view class="section-title">今日状态</view><view class="status-dot"></view></view>
    <view class="pill-row">
      <text class="pill">{{status.cycle}}</text><text class="pill">{{status.sleep}}</text><text class="pill">{{status.energy}}</text>
    </view>
    <view class="recommend-title">{{recommendation.title}}</view>
    <view class="subtitle">{{recommendation.detail}}</view>
  </view>

  <view class="grid-2 quick-grid">
    <view wx:for="{{quickItems}}" wx:key="type" class="card quick-card {{item.wide ? 'quick-wide' : ''}}" data-type="{{item.type}}" bindtap="openRecord">
      <view class="quick-label">{{item.label}}</view>
      <view class="quick-value">{{item.value}}</view>
      <view class="quick-note">{{item.note}}</view>
    </view>
  </view>

  <button class="button-primary record-cta" bindtap="openRecord">用一句话记录今天</button>

  <view class="today-section">
    <view class="row section-heading">
      <view class="section-title">今日计划</view>
      <view class="accent" bindtap="openPlans">{{planProgressText}}</view>
    </view>
    <view wx:if="{{activePlans.length}}" class="plan-list">
      <view wx:for="{{activePlans}}" wx:key="id" class="plan-row" bindtap="openPlans">
        <view class="plan-check {{item.completedToday ? 'is-complete' : ''}}">{{item.completedToday ? '✓' : ''}}</view>
        <view class="plan-copy">
          <view class="plan-name">{{item.name}}</view>
          <view class="plan-time">{{item.schedule}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-plan" bindtap="openPlans">从一个简单模板开始安排今天</view>
  </view>

  <view class="ai-entry" bindtap="openAi">
    <view class="ai-mark">AI</view>
    <view class="ai-copy">
      <view class="ai-title">和 Her Rhyme 聊聊</view>
      <view class="quick-note">关于状态、训练和恢复的对话入口</view>
    </view>
    <view class="ai-state">即将开放</view>
  </view>

  <view class="card trend-card">
    <view class="row"><view class="section-title">本周身体地图</view><view class="accent" bindtap="openBodyMap">查看记录</view></view>
    <view class="trend-line"><view class="trend-fill" style="width: {{trendPercent}}%;"></view></view>
    <view class="row trend-meta"><text>{{trendText}}</text><text>{{logCount}} 条记录</text></view>
  </view>
</view>
