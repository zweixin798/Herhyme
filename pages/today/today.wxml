<view class="page today-page">
  <view class="today-head row">
    <view class="luna-greeting" bindtap="openAi">
      <view class="luna-avatar">L</view>
      <view class="greeting-bubble">
        <view class="greeting-text">{{greetingText}}</view>
        <view class="greeting-status"><view class="greeting-dot"></view><text>LUNA</text></view>
      </view>
    </view>
    <view class="date-label">{{todayLabel}}</view>
  </view>

  <button class="button-primary record-cta" bindtap="openRecord">
    <text>用一句话记录今天</text><text class="cta-arrow">→</text>
  </button>

  <view class="today-section">
    <view class="section-heading row">
      <view>
        <view class="section-kicker">01 · ROUTINE</view>
        <view class="section-title">正在执行</view>
      </view>
      <view class="section-link" bindtap="openPlans">{{planProgressText}}</view>
    </view>
    <view wx:if="{{recoveryReminder}}" class="recovery-note">
      <view class="recovery-label">RECOVERY</view>
      <view class="recovery-copy">{{recoveryReminder}}</view>
    </view>
    <view wx:if="{{activePlans.length}}" class="plan-list">
      <view wx:for="{{activePlans}}" wx:key="id" class="plan-row" bindtap="openPlans">
        <view class="plan-check {{item.completedToday ? 'is-complete' : ''}}">{{item.completedToday ? '✓' : ''}}</view>
        <view class="plan-copy">
          <view class="plan-name">{{item.name}}</view>
          <view class="plan-time">{{item.schedule}}</view>
        </view>
        <view class="row-arrow">→</view>
      </view>
    </view>
    <view wx:else class="empty-plan row" bindtap="openPlans"><text>从一个简单模板开始</text><text>→</text></view>
  </view>

  <view class="quick-section">
    <view class="section-heading row">
      <view>
        <view class="section-kicker">02 · CHECK IN</view>
        <view class="section-title">记录今日信号</view>
      </view>
      <view class="section-count">05</view>
    </view>
    <view class="quick-list">
      <view wx:for="{{quickItems}}" wx:key="type" wx:for-index="idx" class="quick-row" data-type="{{item.type}}" bindtap="openRecord">
        <view class="quick-index">{{idx + 1}}</view>
        <view class="quick-label">{{item.label}}</view>
        <view class="quick-value">{{item.value}}</view>
        <view class="row-arrow">→</view>
      </view>
    </view>
  </view>

  <view class="trend-section">
    <view class="row trend-heading">
      <view>
        <view class="section-kicker">03 · BODY MAP</view>
        <view class="section-title">本周身体地图</view>
      </view>
      <view class="section-link" bindtap="openBodyMap">查看记录 →</view>
    </view>
    <view class="trend-line"><view class="trend-fill" style="width: {{trendPercent}}%;"></view></view>
    <view class="row trend-meta"><text>{{trendText}}</text><text>{{logCount}} 条记录</text></view>
  </view>
</view>
