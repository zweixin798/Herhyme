.today-page { padding-top: 38rpx; }
.today-head { align-items: flex-end; padding-bottom: 28rpx; }
.today-head .title { margin-top: 10rpx; }
.date-label { color: #6f7671; font-size: 21rpx; padding-bottom: 6rpx; }

.ai-entry { background: #dfe9e2; border-radius: 8rpx; min-height: 226rpx; padding: 30rpx; position: relative; transition: opacity 160ms ease, transform 160ms ease; }
.ai-entry:active { opacity: .82; transform: translateY(2rpx); }
.ai-mark { border: 1rpx solid #4f705d; border-radius: 50%; color: #365242; font-size: 20rpx; font-weight: 650; height: 52rpx; line-height: 50rpx; text-align: center; width: 52rpx; }
.ai-state { color: #567161; font-size: 19rpx; }
.ai-title { font-size: 38rpx; font-weight: 620; margin-top: 46rpx; }
.ai-arrow { bottom: 28rpx; color: #4f705d; font-size: 34rpx; position: absolute; right: 30rpx; }

.status-section { background: #ffffff; border-radius: 8rpx; margin-top: 28rpx; overflow: hidden; padding: 28rpx 28rpx 0; }
.status-head { color: #657069; font-size: 20rpx; }
.status-live { gap: 12rpx; }
.status-dot { animation: quiet-pulse 2.4s ease-in-out infinite; background: #4f705d; border-radius: 50%; height: 12rpx; width: 12rpx; }
.recommend-title { font-size: 42rpx; font-weight: 630; line-height: 1.25; margin-top: 38rpx; max-width: 620rpx; }
.recommend-detail { margin-top: 14rpx; max-width: 620rpx; }
.signal-strip { border-top: 1rpx solid #e0e4e0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 38rpx; }
.signal-cell { border-right: 1rpx solid #d9ded9; min-height: 146rpx; padding: 24rpx 18rpx 22rpx 0; }
.signal-cell + .signal-cell { padding-left: 18rpx; }
.signal-cell-last { border-right: 0; padding-right: 0; }
.signal-label { color: #8a918c; font-size: 19rpx; }
.signal-value { display: -webkit-box; font-size: 23rpx; font-weight: 570; line-height: 1.45; margin-top: 14rpx; overflow: hidden; overflow-wrap: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

.quick-section { padding: 54rpx 0 58rpx; }
.section-heading { align-items: flex-end; margin-bottom: 24rpx; }
.section-heading .section-title { margin-top: 8rpx; }
.section-count { color: #9aa19c; font-size: 22rpx; }
.quick-list { display: block; }
.quick-row { align-items: center; border-bottom: 1rpx solid #d9ded9; display: flex; min-height: 154rpx; padding: 22rpx 0; transition: background-color 160ms ease, padding 160ms ease; }
.quick-row:active { background: #edf1ed; padding-left: 8rpx; }
.quick-index { color: #9aa19c; flex: 0 0 46rpx; font-size: 19rpx; }
.quick-copy { flex: 1; min-width: 0; }
.quick-label { color: #4f705d; font-size: 20rpx; font-weight: 600; }
.quick-value { display: -webkit-box; font-size: 29rpx; font-weight: 620; line-height: 1.35; margin-top: 8rpx; overflow: hidden; overflow-wrap: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.quick-note { color: #858c87; font-size: 20rpx; margin-top: 6rpx; }
.row-arrow { color: #717a74; flex: 0 0 auto; font-size: 28rpx; margin-left: 20rpx; }
.record-cta { justify-content: space-between; margin-top: 30rpx; width: 100%; }
.cta-arrow { font-size: 32rpx; font-weight: 400; }

.today-section { background: #ffffff; border-radius: 8rpx; padding: 30rpx 28rpx 34rpx; }
.section-link { color: #4f705d; font-size: 20rpx; max-width: 260rpx; text-align: right; }
.plan-list { display: block; }
.plan-row { align-items: center; border-bottom: 1rpx solid #d9ded9; display: flex; min-height: 106rpx; padding: 16rpx 0; }
.plan-check { border: 1rpx solid #87918a; border-radius: 50%; color: #ffffff; flex: 0 0 auto; font-size: 21rpx; height: 38rpx; line-height: 36rpx; margin-right: 20rpx; text-align: center; width: 38rpx; }
.plan-check.is-complete { background: #4f705d; border-color: #4f705d; }
.plan-copy { flex: 1; min-width: 0; }
.plan-name { font-size: 27rpx; font-weight: 610; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.plan-time { color: #858c87; font-size: 20rpx; margin-top: 6rpx; }
.empty-plan { color: #6f7671; font-size: 24rpx; min-height: 104rpx; }

.trend-section { padding: 54rpx 0 20rpx; }
.trend-heading { align-items: flex-end; }
.trend-heading .section-title { margin-top: 8rpx; }
.trend-line { background: #d9ded9; height: 4rpx; margin-top: 42rpx; overflow: hidden; }
.trend-fill { animation: line-grow 850ms 220ms cubic-bezier(.22, .8, .32, 1) both; background: #c76f5d; height: 100%; transform-origin: left; }
.trend-meta { color: #7b827d; font-size: 20rpx; margin-top: 14rpx; }
