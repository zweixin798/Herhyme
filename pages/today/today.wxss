.date-label { color: #777970; font-size: 22rpx; }
.status-card { padding: 30rpx; }
.status-head { margin-bottom: 20rpx; }
.status-dot { background: #536750; border-radius: 50%; height: 18rpx; width: 18rpx; }
.pill-row { margin-bottom: 32rpx; }
.recommend-title { color: #1e1f1d; font-size: 38rpx; font-weight: 700; margin-bottom: 12rpx; }
.quick-grid { gap: 20rpx; }
.quick-card { min-height: 188rpx; min-width: 0; padding: 26rpx; }
.quick-card:active { background: #f4f0e6; }
.quick-wide { grid-column: 1 / -1; min-height: 154rpx; }
.quick-label { color: #777970; font-size: 23rpx; }
.quick-value { color: #1e1f1d; font-size: 31rpx; font-weight: 700; margin-top: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quick-note { color: #777970; font-size: 21rpx; margin-top: 8rpx; }
.record-cta { width: 100%; }
.today-section { border-bottom: 1rpx solid #ded9cc; border-top: 1rpx solid #ded9cc; padding: 34rpx 0; }
.section-heading .accent { font-size: 22rpx; }
.plan-list { margin-top: 12rpx; }
.plan-row { align-items: center; display: flex; min-height: 92rpx; padding: 12rpx 0; }
.plan-check { border: 2rpx solid #a8ad9f; border-radius: 50%; color: #fffef9; flex: 0 0 auto; font-size: 24rpx; height: 42rpx; line-height: 38rpx; margin-right: 20rpx; text-align: center; width: 42rpx; }
.plan-check.is-complete { background: #536750; border-color: #536750; }
.plan-copy { min-width: 0; }
.plan-name { font-size: 28rpx; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.plan-time { color: #777970; font-size: 22rpx; margin-top: 6rpx; }
.empty-plan { color: #777970; font-size: 25rpx; padding: 28rpx 0 8rpx; }
.ai-entry { align-items: center; background: #e8ebdf; border: 1rpx solid #d3d8ca; border-radius: 16rpx; display: flex; padding: 26rpx; }
.ai-mark { align-items: center; background: #536750; border-radius: 12rpx; color: #fffef9; display: flex; flex: 0 0 auto; font-size: 22rpx; font-weight: 700; height: 64rpx; justify-content: center; width: 64rpx; }
.ai-copy { flex: 1; margin-left: 20rpx; min-width: 0; }
.ai-title { font-size: 28rpx; font-weight: 650; }
.ai-copy .quick-note { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ai-state { color: #536750; flex: 0 0 auto; font-size: 21rpx; margin-left: 12rpx; }
.trend-card { padding: 30rpx; }
.trend-line { background: #e9e4d9; border-radius: 999rpx; height: 18rpx; margin-top: 30rpx; overflow: hidden; }
.trend-fill { background: #536750; border-radius: 999rpx; height: 100%; }
.trend-meta { color: #777970; font-size: 22rpx; margin-top: 14rpx; }
