.record-page { padding-top: 44rpx; }
.page-head { margin-bottom: 28rpx; }
.record-intro { margin-top: 14rpx; }
.record-editor { border-bottom: 1rpx solid #ded9cc; margin-top: 26rpx; padding-bottom: 42rpx; }
.editor-label { margin-bottom: 18rpx; }
.parsing-state { color: #536750; font-size: 22rpx; }
.record-editor .textarea { min-height: 210rpx; }
.suggestion { color: #777970; font-size: 22rpx; line-height: 1.5; margin: 18rpx 4rpx 22rpx; }
.save-record { width: 100%; }
.parse-error { background: #f3e9e5; border: 1rpx solid #e4ccc5; border-radius: 14rpx; color: #8b4f49; margin-top: 20rpx; padding: 22rpx 24rpx; }
.parse-error-text { font-size: 24rpx; line-height: 1.5; }
.parse-error-actions { justify-content: flex-start; margin-top: 14rpx; }
.parse-error-actions .button-secondary { line-height: 64rpx; }
.text-button { background: transparent; color: #8b625d; font-size: 23rpx; margin: 0; padding: 0; }
.inline-button { line-height: 64rpx; margin-left: 24rpx; }
.parse-card { background: #fffef9; border: 1rpx solid #d8d8c9; border-radius: 16rpx; margin-top: 24rpx; padding: 28rpx; }
.parse-heading { align-items: center; }
.parsed-type { background: #e8ebdf; border-radius: 999rpx; color: #536750; font-size: 22rpx; padding: 10rpx 16rpx; }
.confirm-question { color: #4f5f4d; font-size: 28rpx; line-height: 1.6; margin-top: 22rpx; }
.parse-notice { background: #f3efe4; border-left: 6rpx solid #9a835d; color: #675e50; font-size: 23rpx; line-height: 1.55; margin-top: 18rpx; padding: 18rpx 20rpx; }
.parsed-fields { border-top: 1rpx solid #e3ded2; margin-top: 24rpx; padding-top: 24rpx; }
.field-caption { color: #777970; font-size: 22rpx; margin-bottom: 10rpx; }
.diet-item { border-bottom: 1rpx solid #ebe7dc; padding: 18rpx 0 24rpx; }
.diet-item:first-child { padding-top: 0; }
.diet-item-head { margin-bottom: 12rpx; }
.remove-item { background: transparent; color: #8b625d; font-size: 22rpx; line-height: 52rpx; margin: 0; padding: 0; }
.compact-input { background: #f8f6ef; border: 1rpx solid #ded9cc; border-radius: 12rpx; color: #1e1f1d; font-size: 26rpx; height: 76rpx; margin-bottom: 12rpx; padding: 0 18rpx; width: 100%; }
.diet-number-grid { display: grid; gap: 12rpx; grid-template-columns: 1fr 1fr; }
.diet-number-grid .compact-input { margin-bottom: 0; }
.add-item { font-size: 24rpx; line-height: 68rpx; margin-top: 18rpx; width: 100%; }
.picker-value { background: #f8f6ef; border: 1rpx solid #ded9cc; border-radius: 12rpx; color: #1e1f1d; font-size: 26rpx; height: 76rpx; padding: 0 18rpx; }
.compact-picker { line-height: 76rpx; }
.period-switch { border-bottom: 1rpx solid #ebe7dc; color: #4d504a; font-size: 25rpx; margin: 10rpx 0 4rpx; padding: 16rpx 0; }
.spaced-caption { margin-top: 12rpx; }
.parse-actions { border-top: 1rpx solid #e3ded2; margin-top: 28rpx; padding-top: 24rpx; }
.parse-actions .button-primary, .parse-actions .button-secondary { width: 100%; }
.parse-actions .button-secondary { margin-top: 14rpx; }
.saved-note { background: #e8ebdf; border-radius: 12rpx; color: #536750; font-size: 23rpx; margin-top: 20rpx; padding: 20rpx 24rpx; }
.map-section { border-bottom: 1rpx solid #ded9cc; padding: 48rpx 0 42rpx; }
.map-heading { align-items: flex-end; }
.range-title { color: #777970; font-size: 22rpx; margin-top: 8rpx; }
.range-tabs { background: #ebe7dc; border-radius: 12rpx; display: flex; padding: 5rpx; }
.range-tab { border-radius: 9rpx; color: #777970; font-size: 23rpx; line-height: 54rpx; text-align: center; width: 64rpx; }
.range-tab.active { background: #fffef9; color: #1e1f1d; font-weight: 650; }
.map-summary { display: flex; gap: 48rpx; margin-top: 34rpx; }
.summary-value { font-size: 44rpx; font-weight: 700; }
.summary-label { color: #777970; font-size: 22rpx; margin-left: 10rpx; }
.chart { align-items: flex-end; display: flex; gap: 10rpx; height: 250rpx; margin-top: 30rpx; }
.chart-column { align-items: center; display: flex; flex: 1; flex-direction: column; height: 100%; justify-content: flex-end; min-width: 0; }
.bar-track { align-items: flex-end; background: #ebe7dc; border-radius: 8rpx 8rpx 3rpx 3rpx; display: flex; flex: 1; overflow: hidden; width: 70%; }
.bar-fill { background: #6e8068; border-radius: 8rpx 8rpx 3rpx 3rpx; min-height: 8%; width: 100%; }
.bar-label { color: #777970; font-size: 19rpx; margin-top: 12rpx; text-align: center; white-space: nowrap; }
.category-counts { border-top: 1rpx solid #e3ded2; display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 28rpx; padding-top: 24rpx; }
.count-item { align-items: center; color: #777970; display: flex; flex-direction: column; font-size: 21rpx; gap: 6rpx; }
.count-number { color: #1e1f1d; font-size: 30rpx; font-weight: 650; }
.map-insight { background: #e8ebdf; border-radius: 12rpx; color: #4f5f4d; font-size: 24rpx; line-height: 1.6; margin-top: 28rpx; padding: 22rpx 24rpx; }
.recent-section { padding-top: 42rpx; }
.recent-section .section-title { margin-bottom: 14rpx; }
.log-row { align-items: flex-start; border-bottom: 1rpx solid #e3ded2; display: flex; padding: 24rpx 0; }
.log-main { flex: 1; min-width: 0; }
.log-meta { color: #888980; font-size: 21rpx; }
.log-type { color: #536750; margin-right: 16rpx; }
.log-content { color: #1e1f1d; font-size: 27rpx; line-height: 1.55; margin-top: 10rpx; overflow-wrap: break-word; }
.delete-button { background: transparent; color: #8b625d; flex: 0 0 auto; font-size: 34rpx; height: 56rpx; line-height: 50rpx; margin: 4rpx 0 0 18rpx; padding: 0; width: 56rpx; }
.empty-records { color: #888980; font-size: 25rpx; padding: 34rpx 0; }
