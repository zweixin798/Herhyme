<view class="page record-page">
  <view class="page-head">
    <view class="eyebrow">HER RHYME / BODY MAP</view>
    <view class="title">身体地图</view>
  </view>

  <view class="map-section">
    <view class="map-heading row">
      <view>
        <view class="section-kicker">01 · RHYTHM</view>
        <view class="section-title">{{rangeTitle}}</view>
      </view>
      <view class="range-tabs">
        <text wx:for="{{ranges}}" wx:key="value" class="range-tab {{activeRange === item.value ? 'active' : ''}}" data-range="{{item.value}}" bindtap="selectRange">{{item.label}}</text>
      </view>
    </view>

    <view class="map-summary">
      <view><text class="summary-value">{{rangeStats.records}}</text><text class="summary-label">条记录</text></view>
      <view><text class="summary-value">{{rangeStats.activeDays}}</text><text class="summary-label">个活跃日</text></view>
    </view>

    <view class="chart">
      <view wx:for="{{chartItems}}" wx:key="key" class="chart-column">
        <view class="bar-track"><view class="bar-fill" style="height: {{item.height}}%;"></view></view>
        <view class="bar-label">{{item.label}}</view>
      </view>
    </view>

    <view class="category-counts">
      <view class="count-item"><text>饮食</text><text class="count-number">{{counts.diet}}</text></view>
      <view class="count-item"><text>训练</text><text class="count-number">{{counts.training}}</text></view>
      <view class="count-item"><text>睡眠</text><text class="count-number">{{counts.sleep}}</text></view>
      <view class="count-item"><text>经期</text><text class="count-number">{{counts.cycle}}</text></view>
      <view class="count-item"><text>心情</text><text class="count-number">{{counts.mood}}</text></view>
    </view>

    <view class="map-insight">{{rangeInsight}}</view>
  </view>

  <view class="trend-section">
    <view class="section-heading row">
      <view>
        <view class="section-kicker">02 · RECENT TRENDS</view>
        <view class="section-title">近期趋势</view>
      </view>
      <view class="trend-window">近 7 天</view>
    </view>

    <view class="recovery-panel {{recovery.tone}}">
      <view class="recovery-label">{{recovery.label}}</view>
      <view class="recovery-status">{{recovery.status}}</view>
      <view class="recovery-summary">{{recovery.summary}}</view>
    </view>

    <view class="signal-list">
      <view wx:for="{{trendSignals}}" wx:key="key" class="signal-row">
        <view class="signal-label">{{item.label}}</view>
        <view class="signal-copy">
          <view class="signal-value">{{item.value}}</view>
          <view class="signal-detail">{{item.detail}}</view>
        </view>
      </view>
    </view>

    <view class="quality-row">
      <view class="quality-item"><view class="quality-label">记录完整度</view><view class="quality-value">{{completenessText}}</view></view>
      <view class="quality-item"><view class="quality-label">信号覆盖</view><view class="quality-value">{{coverageText}}</view></view>
    </view>
  </view>

  <view class="advice-section">
    <view class="section-kicker">03 · FOR YOU</view>
    <view class="section-title">身体建议</view>
    <view class="advice-list">
      <view wx:for="{{recommendations}}" wx:key="*this" class="advice-row">
        <view class="advice-index">{{index + 1}}</view>
        <view class="advice-copy">{{item}}</view>
      </view>
    </view>
  </view>
</view>
