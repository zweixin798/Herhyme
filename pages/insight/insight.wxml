<view class="page insight-page">
  <view class="insight-head">
    <view class="eyebrow">HER RHYME / BODY INSIGHT</view>
    <view class="title"><view>你的身体地图</view><view>正在形成。</view></view>
  </view>

  <view class="insight-section">
    <view class="row"><view><view class="section-kicker">01 · OVERVIEW</view><view class="section-title">记录概览</view></view><view class="accent">{{logs.length}} 条</view></view>
    <view class="insight-metrics">
      <view><view class="metric-value">{{counts.diet}}</view><view class="metric-label">饮食</view></view>
      <view><view class="metric-value">{{counts.training}}</view><view class="metric-label">训练</view></view>
      <view><view class="metric-value">{{counts.sleep}}</view><view class="metric-label">睡眠</view></view>
      <view><view class="metric-value">{{counts.mood}}</view><view class="metric-label">心情</view></view>
      <view><view class="metric-value">{{counts.cycle}}</view><view class="metric-label">经期</view></view>
    </view>
  </view>

  <view class="insight-section reminder-section">
    <view class="section-kicker">02 · NOTE</view>
    <view class="section-title">本周提醒</view>
    <view class="insight-copy">{{insightText}}</view>
  </view>

  <view class="log-section">
    <view class="section-kicker">03 · ARCHIVE</view>
    <view class="section-title">最近记录</view>
    <view wx:for="{{logs}}" wx:key="createdAt" class="log-item">
      <view class="row"><text class="log-type">{{item.typeLabel}}</text><text class="muted">{{item.dateLabel}}</text></view>
      <view class="log-content">{{item.content}}</view>
    </view>
    <view wx:if="{{!logs.length}}" class="subtitle empty">还没有记录，从今天开始就好。</view>
  </view>
</view>
