.plan-page { padding-top: 38rpx; }
.page-head { align-items: flex-end; padding-bottom: 42rpx; }
.page-head .title { margin-top: 10rpx; }
.add-button { background: transparent; border: 1rpx solid #9da69f; border-radius: 50%; color: #25332b; font-size: 32rpx; height: 66rpx; line-height: 62rpx; margin: 0; padding: 0; transition: transform 180ms ease; width: 66rpx; }
.add-button:active { transform: rotate(12deg); }

.custom-editor { background: #e9eee9; border-radius: 8rpx; margin: 0 0 12rpx; padding: 34rpx 30rpx 40rpx; }
.editor-heading { align-items: flex-start; margin-bottom: 18rpx; }
.editor-heading .section-title { margin-top: 8rpx; }
.editor-index { color: #829087; font-size: 21rpx; }
.field-label { color: #737b76; font-size: 20rpx; margin: 28rpx 0 8rpx; }
.form-grid { display: grid; gap: 24rpx; grid-template-columns: 1fr 1fr; }
.picker-value { align-items: center; border-bottom: 1rpx solid #aeb8b0; display: flex; font-size: 26rpx; height: 82rpx; justify-content: space-between; overflow: hidden; padding: 0 2rpx; text-overflow: ellipsis; white-space: nowrap; }
.picker-value text { color: #728078; font-size: 18rpx; }
.custom-textarea { background: #ffffff; border: 0; border-radius: 8rpx; font-size: 27rpx; line-height: 1.65; min-height: 184rpx; padding: 24rpx; width: 100%; }
.save-plan { justify-content: space-between; margin-top: 28rpx; width: 100%; }

.routine-section { padding: 54rpx 0 28rpx; }
.section-row { align-items: flex-end; margin-bottom: 24rpx; }
.section-row .section-title { margin-top: 8rpx; }
.progress-text { color: #7b827d; font-size: 20rpx; max-width: 260rpx; text-align: right; }
.plan-list { display: grid; gap: 16rpx; }
.plan-item { background: #ffffff; border-radius: 8rpx; padding: 28rpx; transition: opacity 180ms ease; }
.plan-item.is-paused { opacity: .46; }
.plan-top, .template-top { min-height: 50rpx; }
.category-label { color: #687f6e; font-size: 19rpx; font-weight: 620; }
.plan-edit-main { padding-bottom: 2rpx; transition: opacity 160ms ease; }
.plan-edit-main:active { opacity: .66; }
.plan-name-row { align-items: flex-start; gap: 20rpx; }
.plan-name-row .plan-name { flex: 1; min-width: 0; }
.plan-edit-link { color: #687f6e; flex: 0 0 auto; font-size: 20rpx; margin-top: 24rpx; }
.plan-name { font-size: 33rpx; font-weight: 630; line-height: 1.25; margin-top: 20rpx; }
.plan-schedule { color: #c06856; font-size: 21rpx; margin-top: 10rpx; }
.plan-detail { color: #6f7671; font-size: 24rpx; line-height: 1.65; margin-top: 16rpx; }
.plan-actions { margin-top: 24rpx; }
.check-label { align-items: center; color: #4e5651; display: flex; font-size: 22rpx; }
.check-label checkbox { margin-right: 8rpx; transform: scale(.78); }
.icon-button { background: transparent; color: #a65f53; font-size: 32rpx; height: 52rpx; line-height: 48rpx; margin: 0; padding: 0; width: 52rpx; }
.empty-state { background: #ffffff; border-radius: 8rpx; padding: 30rpx 28rpx 34rpx; }
.empty-title { font-size: 29rpx; font-weight: 620; margin-bottom: 10rpx; }

.template-section { padding: 42rpx 0 16rpx; }
.template-list { display: block; }
.template-item { border-bottom: 1rpx solid #cfd5d0; padding: 28rpx 0 32rpx; transition: background-color 160ms ease, transform 160ms ease; }
.template-item:active { background: #edf1ed; transform: translateX(4rpx); }
.template-meta { align-items: center; display: flex; }
.template-index { color: #9aa19c; font-size: 18rpx; margin-right: 20rpx; }
.template-action { background: transparent; border: 1rpx solid #78847c; border-radius: 6rpx; color: #31483a; font-size: 20rpx; line-height: 54rpx; margin: 0; padding: 0 18rpx; }
.template-action.is-added { border-color: #a8b7ac; color: #687f6e; }
.safety-note { background: #edf0ed; border-radius: 8rpx; color: #717974; font-size: 20rpx; line-height: 1.65; margin-top: 34rpx; padding: 22rpx 24rpx; }
