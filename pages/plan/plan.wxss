.plan-page { padding-top: 44rpx; }
.page-head { align-items: flex-end; margin-bottom: 44rpx; }
.add-button { background: #ece7da; border-radius: 999rpx; color: #536750; font-size: 24rpx; line-height: 66rpx; margin: 0; padding: 0 24rpx; }
.custom-editor { border-bottom: 1rpx solid #ded9cc; border-top: 1rpx solid #ded9cc; margin-bottom: 42rpx; padding: 34rpx 0 40rpx; }
.custom-editor .section-title { margin-bottom: 30rpx; }
.field-label { color: #777970; font-size: 23rpx; margin: 22rpx 0 12rpx; }
.form-grid { display: grid; gap: 18rpx; grid-template-columns: 1fr 1fr; }
.picker-value { background: #fffef9; border: 1rpx solid #ded9cc; border-radius: 16rpx; height: 88rpx; line-height: 88rpx; overflow: hidden; padding: 0 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.custom-textarea { background: #fffef9; border: 1rpx solid #ded9cc; border-radius: 16rpx; font-size: 28rpx; line-height: 1.55; min-height: 180rpx; padding: 22rpx; width: 100%; }
.save-plan { margin-top: 28rpx; width: 100%; }
.section-row { margin: 34rpx 0 22rpx; }
.progress-text { font-size: 22rpx; }
.plan-item, .template-item { border-radius: 16rpx; margin-bottom: 20rpx; padding: 28rpx; }
.plan-item.is-paused { opacity: .58; }
.plan-top, .template-top { height: 56rpx; }
.category-pill { margin: 0; }
.plan-name { font-size: 34rpx; font-weight: 700; margin-top: 20rpx; }
.plan-schedule { color: #536750; font-size: 24rpx; margin-top: 10rpx; }
.plan-detail { color: #6a6d65; font-size: 26rpx; line-height: 1.6; margin-top: 18rpx; }
.plan-actions { border-top: 1rpx solid #ebe7dc; margin-top: 24rpx; padding-top: 18rpx; }
.check-label { align-items: center; color: #4d504a; display: flex; font-size: 24rpx; }
.check-label checkbox { margin-right: 8rpx; transform: scale(.82); }
.icon-button { background: transparent; border-radius: 50%; color: #8b625d; font-size: 38rpx; height: 56rpx; line-height: 52rpx; margin: 0; padding: 0; width: 56rpx; }
.template-action { background: #1e1f1d; border-radius: 999rpx; color: #fffef9; font-size: 23rpx; line-height: 60rpx; margin: 0; padding: 0 24rpx; }
.template-action.is-added { background: #ece7da; color: #777970; }
.template-heading { margin-top: 52rpx; }
.empty-state { border-bottom: 1rpx solid #ded9cc; padding: 20rpx 0 40rpx; }
.empty-title { font-size: 30rpx; font-weight: 650; margin-bottom: 10rpx; }
.safety-note { color: #888980; font-size: 21rpx; line-height: 1.6; padding: 12rpx 4rpx 30rpx; }
