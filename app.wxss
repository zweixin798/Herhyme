page {
  background: #f5f7f4;
  color: #171a18;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, picker {
  box-sizing: border-box;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  overflow: hidden;
  padding: 44rpx 36rpx 160rpx;
}

.page > view {
  animation: rise-in 420ms cubic-bezier(.22, .8, .32, 1) both;
}

.page > view:nth-child(2) { animation-delay: 45ms; }
.page > view:nth-child(3) { animation-delay: 90ms; }
.page > view:nth-child(4) { animation-delay: 135ms; }
.page > view:nth-child(5) { animation-delay: 180ms; }

@keyframes rise-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes quiet-pulse {
  0%, 100% { opacity: .45; transform: scale(.82); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes line-grow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@keyframes bar-rise {
  from { transform: scaleY(.06); }
  to { transform: scaleY(1); }
}

.eyebrow {
  color: #6d746f;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.2;
  text-transform: uppercase;
}

.brand {
  color: #171a18;
  font-size: 72rpx;
  font-weight: 760;
  letter-spacing: 0;
  line-height: .96;
}

.title {
  color: #171a18;
  font-size: 52rpx;
  font-weight: 680;
  letter-spacing: 0;
  line-height: 1.12;
}

.subtitle {
  color: #6f7671;
  font-size: 26rpx;
  letter-spacing: 0;
  line-height: 1.7;
}

.muted { color: #7b827d; }
.accent { color: #4f705d; }

.card {
  background: transparent;
  border-bottom: 1rpx solid #d9ded9;
  border-radius: 0;
  box-shadow: none;
}

.button-primary {
  align-items: center;
  background: #171a18;
  border-radius: 8rpx;
  color: #ffffff;
  display: flex;
  font-size: 27rpx;
  font-weight: 620;
  justify-content: center;
  letter-spacing: 0;
  line-height: 88rpx;
  min-height: 88rpx;
  padding: 0 30rpx;
  transition: opacity 160ms ease, transform 160ms ease;
}

.button-primary:active,
.button-secondary:active {
  opacity: .76;
  transform: translateY(2rpx);
}

.button-primary[disabled] { opacity: .42; }

.button-secondary {
  background: transparent;
  border: 1rpx solid #aeb6b0;
  border-radius: 8rpx;
  color: #34483c;
  font-size: 25rpx;
  line-height: 74rpx;
  min-height: 74rpx;
  padding: 0 28rpx;
  transition: opacity 160ms ease, transform 160ms ease;
}

.input {
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid #bfc6c0;
  border-radius: 0;
  color: #171a18;
  font-size: 29rpx;
  height: 86rpx;
  padding: 0 2rpx;
}

.textarea {
  background: #ffffff;
  border: 0;
  border-radius: 8rpx;
  color: #171a18;
  font-size: 29rpx;
  line-height: 1.7;
  min-height: 238rpx;
  padding: 28rpx;
  width: 100%;
}

.section-title {
  color: #171a18;
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 0;
  line-height: 1.3;
}

.pill {
  background: transparent;
  border: 0;
  border-radius: 0;
  color: #567161;
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  margin: 0 18rpx 10rpx 0;
  padding: 0;
}

.metric-value {
  color: #171a18;
  font-size: 48rpx;
  font-weight: 640;
  line-height: 1;
}

.metric-label {
  color: #7b827d;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.row { align-items: center; display: flex; justify-content: space-between; }
.grid-2 { display: grid; gap: 20rpx; grid-template-columns: 1fr 1fr; }
.stack > view + view,
.stack > view + navigator,
.stack > navigator + view,
.stack > view + button { margin-top: 0; }

.hairline {
  background: #cfd5d0;
  height: 1rpx;
  width: 100%;
}

.section-kicker {
  color: #7b827d;
  font-size: 19rpx;
  font-weight: 600;
}
